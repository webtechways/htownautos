{
  "name": "ai-services",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ai-services/src",
  "projectType": "application",
  "tags": [
    "scope:ai-services",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/ai-services"
      ],
      "options": {
        "command": "tsc --project apps/ai-services/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register apps/ai-services/src/main.ts"
      }
    }
  }
}
